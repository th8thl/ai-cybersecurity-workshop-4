                  "snippet": {
                    "text": "            cursor.execute(query, [actor.pk])"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "dispatch",
                  "fullyQualifiedName": "dispatch"
                }
              ]
            }
          ],
